{{#if (eq type "image")}}
<div class="message-bubble group flex items-start gap-3 {{#if isOwn}}flex-row-reverse{{/if}}">
  <div class="avatar flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center text-sm font-semibold">
    {{substr author.username 0 1}}
  </div>
  <div class="max-w-xs lg:max-w-md {{#if isOwn}}items-end{{/if}} flex flex-col gap-1">
    <span class="text-xs text-gray-500 {{#if isOwn}}text-right{{/if}}">{{author.username}}</span>
    <div class="rounded-2xl overflow-hidden border border-white/10">
      <img src="{{content}}" alt="Image partagée" class="max-w-full max-h-64 object-contain cursor-pointer hover:opacity-90 transition-opacity" onclick="openLightbox(this.src)" />
    </div>
    <span class="text-xs text-gray-600">{{formatTime createdAt}}</span>
  </div>
</div>
{{else}}
<div class="message-bubble group flex items-start gap-3 {{#if isOwn}}flex-row-reverse{{/if}}">
  <div class="avatar flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center text-sm font-semibold uppercase">
    {{substr author.username 0 1}}
  </div>
  <div class="max-w-xs lg:max-w-md {{#if isOwn}}items-end{{/if}} flex flex-col gap-1">
    <span class="text-xs text-gray-500 {{#if isOwn}}text-right{{/if}}">{{author.username}}</span>
    <div class="px-4 py-2 rounded-2xl text-sm leading-relaxed break-words
      {{#if isOwn}}
        bg-gradient-to-br from-violet-600 to-indigo-600 text-white rounded-tr-sm
      {{else}}
        bg-gray-800 text-gray-100 border border-white/5 rounded-tl-sm
      {{/if}}">
      {{content}}
    </div>
    <span class="text-xs text-gray-600">{{formatTime createdAt}}</span>
  </div>
</div>
{{/if}}
